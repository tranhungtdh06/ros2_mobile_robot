<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="maze_world">
    <!-- 4 Plugin cốt lõi -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ánh sáng & Mặt đất -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TƯỜNG BAO QUANH VÀ VÁCH NGĂN -->
    <model name="maze_walls">
      <static>true</static>
      <!-- Tường Bắc & Nam -->
      <link name="wall_n"><pose>0 5 0.5 0 0 0</pose><collision name="c"><geometry><box><size>10 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual></link>
      <link name="wall_s"><pose>0 -5 0.5 0 0 0</pose><collision name="c"><geometry><box><size>10 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual></link>
      <!-- Tường Đông & Tây -->
      <link name="wall_e"><pose>5 0 0.5 0 0 0</pose><collision name="c"><geometry><box><size>0.2 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual></link>
      <link name="wall_w"><pose>-5 0 0.5 0 0 0</pose><collision name="c"><geometry><box><size>0.2 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual></link>
      <!-- Vách ngăn trong -->
      <link name="inner_1"><pose>2 2 0.5 0 0 0</pose><collision name="c"><geometry><box><size>4 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 1</size></box></geometry><material><ambient>0.2 0.6 0.8 1</ambient></material></visual></link>
      <link name="inner_2"><pose>-2 -1 0.5 0 0 0</pose><collision name="c"><geometry><box><size>0.2 4 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4 1</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient></material></visual></link>
    </model>
  </world>
</sdf>