<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Link vật lý của Camera -->
    <link name="camera_link">
        <visual>
            <geometry><box size="0.02 0.08 0.02"/></geometry>
            <material name="black"><color rgba="0 0 0 1.0"/></material>
        </visual>
        <collision>
            <geometry><box size="0.02 0.08 0.02"/></geometry>
        </collision>
        <xacro:inertial_box mass="0.05" x="0.02" y="0.08" z="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- Gắn Camera lên đầu xe (Cách tâm 18cm về phía trước, cao 8cm) -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.18 0 0.08" rpy="0 0 0"/>
    </joint>

    <!-- Optical Frame: Bắt buộc đối với ROS 2 (Z hướng về trước, X sang phải, Y hướng xuống) -->
    <link name="camera_optical_link"/>
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Cấu hình Cảm biến chiều sâu cho Gazebo Harmonic -->
    <gazebo reference="camera_link">
        <sensor name="depth_camera" type="rgbd_camera">
            <always_on>true</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>camera</topic>
            <gz_frame_id>camera_optical_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.047</horizontal_fov> <!-- Góc nhìn 60 độ -->
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>5.0</far> <!-- Giới hạn nhìn xa 5 mét -->
                </clip>
            </camera>
        </sensor>
    </gazebo>
</robot>